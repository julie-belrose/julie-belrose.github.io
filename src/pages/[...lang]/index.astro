---
// The home page renders whichever page is selected in src/config.ts.
import { HOME_PAGE, type HomePage } from "@/config";
import { getLangPaths } from "@/i18n/utils";

import Projects from "./projects.astro";
import Experiences from "./experiences.astro";
import Education from "./education.astro";
import Skills from "./skills.astro";
import Contact from "./contact.astro";

const PAGES: Record<HomePage, any> = {
	projects: Projects,
	experiences: Experiences,
	education: Education,
	skills: Skills,
	contact: Contact,
};

const Page = PAGES[HOME_PAGE];

export const getStaticPaths = getLangPaths;
---

<Page />
