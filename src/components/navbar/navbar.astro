---
import Container from "../container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import ThemeSwitch from "../ThemeSwitch.astro";
import LangSwitch from "../LangSwitch.astro";
import { getLang, localizePath, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const PAGES = ["projects", "experiences", "education", "skills", "contact"] as const;
const menuitems = PAGES.map((page) => ({ title: t(`nav.${page}`), path: localizePath(`/${page}`, lang) }));

---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href={localizePath("/", lang)} class="text-md"><span class="text-skin-base">{t("nav.home")}</span></a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-skin-base" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item) => (
              <Fragment>
                {item && (
                  <li>
                    <a href={item.path} class="flex lg:px-3 py-2 items-center text-skin-base hover:text-skin-base">
                      <span> {item.title}</span>
                    </a>
                  </li>
                )}
              </Fragment>
            ))
          }
        </ul>
        <LangSwitch />
        <ThemeSwitch />
      </MenuItems>
    </Astronav>
  </header>
</Container>
