---
// Light/dark toggle. The initial theme is applied in Layout.astro (before paint);
// the icon is picked by CSS from the "dark" class, so it is right from the first render.
import Moon from "./ui/icons/moon.astro";
import Sun from "./ui/icons/sun.astro";
import { getLang, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLang(Astro.url));
---

<button
	id="themeSwitch"
	type="button"
	data-label-to-dark={t("theme.toDark")}
	data-label-to-light={t("theme.toLight")}
	class="no-print flex items-center py-2 text-skin-base transition-transform ease-in-out hover:rotate-45"
>
	<span class="dark:hidden"><Moon /></span>
	<span class="hidden dark:inline"><Sun /></span>
</button>

<style>
	:global(.dark) {
		color-scheme: dark;
	}
</style>

<script>
	const button = document.getElementById("themeSwitch") as HTMLButtonElement;
	const root = document.documentElement;

	function updateLabel() {
		const label = root.classList.contains("dark") ? button.dataset.labelToLight : button.dataset.labelToDark;
		button.title = label ?? "";
		button.setAttribute("aria-label", label ?? "");
	}

	updateLabel();

	button.addEventListener("click", () => {
		const isDark = root.classList.toggle("dark");
		localStorage.setItem("theme", isDark ? "dark" : "light");
		updateLabel();
	});

	// Print in light mode, then restore the current theme.
	let wasDark = false;
	window.addEventListener("beforeprint", () => {
		wasDark = root.classList.contains("dark");
		root.classList.remove("dark");
	});
	window.addEventListener("afterprint", () => root.classList.toggle("dark", wasDark));
</script>
