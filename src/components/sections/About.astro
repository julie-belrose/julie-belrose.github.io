---
import { getCV, getLang, useTranslations } from "@/i18n/utils";
import Section from "../Section.astro";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const { summary, summary_second } = getCV(lang).basics;
---

<Section title={t("section.profile")}>
	<p>
		{summary}
	</p>
	<p>
		{summary_second}
	</p>
</Section>
